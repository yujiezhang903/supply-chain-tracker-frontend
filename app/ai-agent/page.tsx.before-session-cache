'use client';

import { useState } from 'react';
import {
  Box,
  Button,
  Paper,
  Stack,
  TextField,
  Typography,
} from '@mui/material';
import SendIcon from '@mui/icons-material/Send';

import DashboardLayout from '@/components/layout/DashboardLayout';
import ChatMessageList from '@/components/ai-agent/ChatMessageList';
import { createTextMessage } from '@/components/ai-agent/lib/chat-session';
import type { ChatMessage } from '@/components/ai-agent/types';

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:3001';

const initialMessages: ChatMessage[] = [
  {
    id: 'welcome',
    role: 'assistant',
    type: 'text',
    createdAt: '2026-07-26T00:00:00.000Z',
    content: {
      markdown:
        'Hello! Ask me about **company levels, countries, revenue, employees or company lists**.',
    },
  },
];

type AiAgentResponse = {
  messages?: ChatMessage[];
  message?: string | string[];
};

export default function AiAgentPage() {
  const [messages, setMessages] =
    useState<ChatMessage[]>(initialMessages);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);

  const handleSend = async () => {
    const value = input.trim();

    if (!value || loading) return;

    const userMessage = createTextMessage('user', value);

    setMessages((current) => [...current, userMessage]);
    setInput('');
    setLoading(true);

    try {
      const response = await fetch(`${API_URL}/ai-agent/chat`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: value,
        }),
      });

      const data = (await response.json()) as AiAgentResponse;

      if (!response.ok) {
        const errorMessage = Array.isArray(data.message)
          ? data.message.join(', ')
          : data.message;

        throw new Error(
          errorMessage || `Request failed: ${response.status}`,
        );
      }

      const assistantMessages = data.messages;

      if (!Array.isArray(assistantMessages)) {
        throw new Error('Invalid response from AI Agent backend');
      }

      setMessages((current) => [
        ...current,
        ...assistantMessages,
      ]);
    } catch (error) {
      const errorMessage =
        error instanceof Error
          ? error.message
          : 'Unknown request error';

      setMessages((current) => [
        ...current,
        createTextMessage(
          'assistant',
          `Unable to contact the AI Agent backend.\n\n**${errorMessage}**`,
        ),
      ]);
    } finally {
      setLoading(false);
    }
  };

  const updateConfirmation = (
    messageId: string,
    status: 'confirmed' | 'cancelled',
  ) => {
    setMessages((current) =>
      current.map((message): ChatMessage => {
        if (
          message.id !== messageId ||
          message.type !== 'confirmation'
        ) {
          return message;
        }

        return {
          ...message,
          content: {
            ...message.content,
            status,
          },
        };
      }),
    );
  };

  return (
    <DashboardLayout>
      <Box sx={{ width: '100%', maxWidth: 1200, mx: 'auto' }}>
        <Typography variant="h4" sx={{ fontWeight: 700 }}>
          AI Agent
        </Typography>

        <Typography color="text.secondary" sx={{ mt: 0.5, mb: 3 }}>
          Ask questions and analyse your supply-chain data.
        </Typography>

        <Paper
          variant="outlined"
          sx={{
            p: { xs: 2, md: 3 },
            minHeight: 520,
            maxHeight: 'calc(100vh - 300px)',
            overflowY: 'auto',
            backgroundColor: '#f8fafc',
          }}
        >
          <ChatMessageList
            messages={messages}
            onConfirm={(id) =>
              updateConfirmation(id, 'confirmed')
            }
            onCancel={(id) =>
              updateConfirmation(id, 'cancelled')
            }
          />
        </Paper>

        <Paper variant="outlined" sx={{ p: 2, mt: 2 }}>
          <Stack
            direction="row"
            spacing={1.5}
            sx={{ alignItems: 'flex-end' }}
          >
            <TextField
              fullWidth
              multiline
              maxRows={4}
              value={input}
              disabled={loading}
              placeholder="Ask about companies, orders or relationships..."
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={(event) => {
                if (
                  event.key === 'Enter' &&
                  !event.shiftKey &&
                  !event.nativeEvent.isComposing
                ) {
                  event.preventDefault();
                  void handleSend();
                }
              }}
            />

            <Button
              variant="contained"
              endIcon={<SendIcon />}
              disabled={loading || !input.trim()}
              onClick={() => void handleSend()}
              sx={{ minWidth: 110, height: 56 }}
            >
              {loading ? 'Sending...' : 'Send'}
            </Button>
          </Stack>
        </Paper>
      </Box>
    </DashboardLayout>
  );
}
